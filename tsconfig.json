{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "es2018"],
    "outDir": "lib",
    "module": "node16",
    "declaration": true,
    "target": "ES2018",
    "types": [],
    "sourceMap": true,
    "moduleResolution": "node16",
    "paths": {
      "src": ["./src/index.ts"],
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
