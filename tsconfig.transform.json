{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "es2018"],
    "outDir": "lib",
    "module": "commonjs",
    "declaration": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "target": "ES2018",
    "sourceMap": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}
